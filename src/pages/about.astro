---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Placeholder from '../components/Placeholder.astro';
import { site } from '../config/site';
import { publicFileExists, resolveImage, SHOW_DRAFTS } from '../lib/content';

const portrait = site.portrait && resolveImage(site.portrait.file) ? site.portrait : null;
const cvFiles = site.cv.filter((f) => publicFileExists(f.path));
const hasLinks = cvFiles.length > 0 || site.links.length > 0;
---

<Base title="About" description={`${site.name} — ${site.role}, ${site.location.toLowerCase()}. Education and areas of practice.`}>
  <div class="about">
    <div class="about-portrait">
      {
        portrait ? (
          <Media media={{ file: portrait.file, alt: portrait.alt, aspect: '4/5', fit: 'cover' }} sizes="(min-width: 900px) 36vw, 100vw" eager />
        ) : (
          <Placeholder label="Portrait to come" aspect="4/5" glyph="SG" />
        )
      }
    </div>

    <div class="about-body">
      <header>
        <h1 class="display">About</h1>
      </header>

      <div class="about-intro">
        {site.about.map((p) => <p>{p}</p>)}
      </div>

      <section aria-labelledby="edu-label">
        <h2 class="eyebrow section-label" id="edu-label">Education</h2>
        <ul class="edu">
          {site.education.map((e) => (
            <li>
              <span class="edu-field">{e.field}</span>
              <span>{e.level}, {e.institution}</span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="practice-label">
        <h2 class="eyebrow section-label" id="practice-label">Practice</h2>
        <ul class="practice">
          {site.practice.map((p) => <li>{p}</li>)}
        </ul>
      </section>

      {
        (hasLinks || SHOW_DRAFTS) && (
          <section aria-labelledby="links-label">
            <h2 class="eyebrow section-label" id="links-label">CV &amp; links</h2>
            <ul class="link-list">
              {cvFiles.map((f) => (
                <li><a class="text-link" href={f.path} download>{f.label} <span aria-hidden="true">↓</span></a></li>
              ))}
              {site.links.map((l) => (
                <li><a class="text-link" href={l.url} rel="me noopener" target="_blank">{l.label} <span aria-hidden="true">↗</span><span class="visually-hidden">(opens in a new tab)</span></a></li>
              ))}
            </ul>
            {SHOW_DRAFTS && cvFiles.length === 0 && (
              <p class="draft-note" style="margin-top:1rem"><span><strong>Preview note.</strong> No CV file yet — add it to <code>public/documents/</code> and list it under <code>cv</code> in <code>src/config/site.ts</code>.</span></p>
            )}
          </section>
        )
      }

      <section aria-labelledby="contact-label">
        <h2 class="eyebrow section-label" id="contact-label">Contact</h2>
        <p>{site.availability}</p>
        <p><a class="text-link" href="/contact">Get in touch <span class="arrow" aria-hidden="true">→</span></a></p>
      </section>
    </div>
  </div>
</Base>
