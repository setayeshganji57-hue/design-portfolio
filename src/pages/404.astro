---
import Base from '../layouts/Base.astro';
import { categories } from '../config/categories';
---

<Base title="Page not found" noindex>
  <div class="notfound">
    <p class="eyebrow">Error 404</p>
    <h1 class="display"><span>This page</span> <span>was cut.</span></h1>
    <span class="notfound-cut" aria-hidden="true"></span>
    <p class="lede">The address may have changed, or the page is no longer here. Try one of the disciplines instead.</p>
    <ul class="empty-links">
      {categories.map((c) => <li><a class="text-link" href={`/work/${c.slug}`}>{c.title} <span class="arrow" aria-hidden="true">→</span></a></li>)}
      <li><a class="text-link" href="/">Home <span class="arrow" aria-hidden="true">→</span></a></li>
    </ul>
  </div>
</Base>
