---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { SHOW_DRAFTS } from '../lib/content';
---

<Base title="Contact" description={`Contact ${site.name} — ${site.role}. ${site.availability}`}>
  <div class="contact">
    <header class="essays-head">
      <h1 class="display">Contact</h1>
      <p class="lede">{site.availability}</p>
    </header>

    <div class="contact-grid">
      <section aria-labelledby="email-label">
        <h2 class="eyebrow section-label" id="email-label">Email</h2>
        {
          site.email ? (
            <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
          ) : (
            <div class="notice">
              <p>A direct email address will be listed here shortly. In the meantime, I can be reached through the profile below.</p>
              {SHOW_DRAFTS && (
                <p class="meta" style="margin-top:0.6rem">Preview note: set <code>email</code> in <code>src/config/site.ts</code>.</p>
              )}
            </div>
          )
        }
      </section>

      <section aria-labelledby="profiles-label">
        <h2 class="eyebrow section-label" id="profiles-label">Profiles</h2>
        {
          site.links.length > 0 ? (
            <ul class="link-list">
              {site.links.map((l) => (
                <li>
                  <a class="text-link" href={l.url} rel="me noopener" target="_blank">
                    {l.label} <span aria-hidden="true">↗</span><span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="meta">Professional links will be added here.</p>
          )
        }
        <p class="meta" style="margin-top:1.25rem">{site.location}</p>
      </section>
    </div>
  </div>
</Base>
