---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import { categories, type Category } from '../../config/categories';
import { getProjectsIn } from '../../lib/content';

export const getStaticPaths = (() =>
  categories.map((category) => ({ params: { category: category.slug }, props: { category } }))) satisfies GetStaticPaths;

interface Props {
  category: Category;
}

const { category } = Astro.props;
const projects = await getProjectsIn(category.slug);
const index = categories.findIndex((c) => c.slug === category.slug);
const prevCategory = categories[(index - 1 + categories.length) % categories.length];
const nextCategory = categories[(index + 1) % categories.length];
---

<Base title={category.title} description={category.intro} section={category.slug}>
  <header class={`cat-band band--${category.slug}`}>
    <h1 class="display">{category.displayLines.map((l, i) => <>{i > 0 && ' '}<span>{l}</span></>)}</h1>
    <div class="cat-aside">
      <p class="cat-intro">{category.intro}</p>
      {projects.length > 0 && <p class="meta">{projects.length === 1 ? '1 project' : `${projects.length} projects`}</p>}
    </div>
  </header>

  {
    projects.length > 0 ? (
      <ol class="projects">
        {projects.map((project, i) => (
          <ProjectPreview project={project} index={i} />
        ))}
      </ol>
    ) : (
      <div class="coming-soon">
        <p>Coming soon</p>
      </div>
    )
  }

  <nav class="cat-pager" aria-label="Other disciplines">
    <a class={`cat-pager-link band--${prevCategory.slug}`} href={`/work/${prevCategory.slug}`} rel="prev">
      <span class="cat-pager-dir"><span aria-hidden="true">←</span> Previous discipline</span>
      <span class="cat-pager-title">{prevCategory.title}</span>
    </a>
    <a class={`cat-pager-link band--${nextCategory.slug}`} href={`/work/${nextCategory.slug}`} rel="next">
      <span class="cat-pager-dir">Next discipline <span aria-hidden="true">→</span></span>
      <span class="cat-pager-title">{nextCategory.title}</span>
    </a>
  </nav>
</Base>
