---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import Media from '../components/Media.astro';
import { site } from '../config/site';
import { resolveImage } from '../lib/content';

const portrait = site.portrait && resolveImage(site.portrait.file) ? site.portrait : null;
---

<Base title="About" description={site.about[0]}>
  <div class="split">
    <div class="split-head">
      <h1 class="split-title">About</h1>
      <div class="about-portrait">
        {
          portrait ? (
            <Media media={{ file: portrait.file, alt: portrait.alt, aspect: '4/5', fit: 'cover' }} sizes="(min-width: 900px) 30vw, 100vw" eager />
          ) : (
            <Placeholder label="Portrait to come" aspect="4/5" glyph="SG" />
          )
        }
      </div>
    </div>

    <div class="split-body">
      <div class="about-intro">
        {site.about.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</Base>
