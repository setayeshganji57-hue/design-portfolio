---
import { categories } from '../config/categories';

interface Props {
  /** Normalised path of the current page, e.g. "/work/brand-identity". */
  current: string;
  /** Discipline the current page belongs to (project pages). */
  section?: string;
  id: string;
}

const { current, section, id } = Astro.props;

const pages = [
  { href: '/essays', label: 'Essays' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const workState = (slug: string) => {
  const href = `/work/${slug}`;
  if (current === href) return 'page';
  if (section === slug) return 'true';
  return undefined;
};

const pageState = (href: string) => {
  if (current === href) return 'page';
  if (current.startsWith(href + '/')) return 'true';
  return undefined;
};
---

<nav class="nav" aria-label="Main">
  <div>
    <p class="nav-label eyebrow" id={`${id}-work`}>Work</p>
    <ol class="nav-work" aria-labelledby={`${id}-work`}>
      {
        categories.map((c) => (
          <li>
            <a href={`/work/${c.slug}`} aria-current={workState(c.slug)}>
              <span>{c.title}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
  <ul class="nav-pages">
    {
      pages.map((p) => (
        <li>
          <a href={p.href} aria-current={pageState(p.href)}>
            {p.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
