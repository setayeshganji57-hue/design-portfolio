---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { contextLabel, essayReadingMinutes, essayYear, getReadableEssays, publicFileExists, type Essay } from '../../lib/content';

export const getStaticPaths = (async () => {
  const essays = await getReadableEssays();
  return essays.map((essay) => ({ params: { slug: essay.id }, props: { essay } }));
}) satisfies GetStaticPaths;

interface Props {
  essay: Essay;
}

const { essay } = Astro.props;
const d = essay.data;
const { Content } = await render(essay);
const minutes = essayReadingMinutes(essay);
const hasPdf = publicFileExists(d.pdf);
const year = essayYear(essay);
const notPublic = d.status !== 'published' || d.specimen;
---

<Base title={d.title} description={d.abstract ?? `${d.title} — essay by Setayesh Ganji.`} noindex={notPublic}>
  <article class="essay" lang={d.lang} dir={["fa", "ar", "he", "ur"].includes(d.lang.split("-")[0]) ? "rtl" : undefined}>
    <nav class="crumbs" aria-label="Breadcrumb" lang="en">
      <a class="text-link" href="/essays"><span class="arrow" aria-hidden="true">←</span> Essays</a>
    </nav>

    {
      notPublic && (
        <aside class="draft-note" aria-label="Preview note" lang="en">
          {d.specimen ? (
            <p><strong>Layout specimen.</strong> This text demonstrates the reading template. It is not writing by Setayesh Ganji and is never included in a production build.</p>
          ) : (
            <p><strong>{d.status === 'draft' ? 'Draft' : 'In progress'} — preview only.</strong> Not readable in production until the status is “published”.</p>
          )}
        </aside>
      )
    }

    <header>
      <p class="eyebrow" lang="en">{d.kind === 'thesis' ? 'Master’s thesis' : 'Essay'}</p>
      <h1 class="essay-title" style="margin-top:0.75rem">{d.title}</h1>
      <p class="essay-meta" lang="en">
        {year && <span>{d.date ? <time datetime={d.date.toISOString().slice(0, 10)}>{year}</time> : year}</span>}
        {contextLabel(d.context) && <span>{contextLabel(d.context)}</span>}
        <span>{d.language}</span>
        {minutes >= 3 && <span>{minutes} min read</span>}
        {d.tags.length > 0 && <span>{d.tags.join(', ')}</span>}
      </p>
      {
        d.abstract && (
          <section class="essay-abstract" aria-labelledby="abstract-label">
            <h2 class="eyebrow" id="abstract-label" lang="en">Abstract</h2>
            <p>{d.abstract}</p>
          </section>
        )
      }
      {
        hasPdf && (
          <p class="essay-pdf" lang="en">
            <a class="button" href={d.pdf} target="_blank" rel="noopener">Open PDF <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
            <a class="button button--quiet" href={d.pdf} download>Download PDF <span aria-hidden="true">↓</span></a>
          </p>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      (d.references.length > 0 || d.imageCredits.length > 0) && (
        <footer class="essay-end" lang="en">
          {d.references.length > 0 && (
            <section aria-labelledby="refs-label">
              <h2 class="eyebrow" id="refs-label">References</h2>
              <ol>{d.references.map((r) => <li>{r}</li>)}</ol>
            </section>
          )}
          {d.imageCredits.length > 0 && (
            <section aria-labelledby="credits-label">
              <h2 class="eyebrow" id="credits-label">Image credits</h2>
              <ol>{d.imageCredits.map((r) => <li>{r}</li>)}</ol>
            </section>
          )}
        </footer>
      )
    }
    <p style="margin-top:2.5rem" lang="en"><a class="text-link" href="/essays"><span class="arrow" aria-hidden="true">←</span> All essays</a></p>
  </article>
</Base>
