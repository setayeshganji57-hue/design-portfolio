---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/standard-italic.css';
import '@fontsource-variable/instrument-sans/standard.css';
import '../styles/global.css';
import cutScript from '../scripts/cut.js?raw';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { SHOW_DRAFTS } from '../lib/content';

interface Props {
  /** Page title; the site name is appended. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Discipline slug this page belongs to (highlights it in navigation). */
  section?: string;
  /** Mark as not indexable (drafts, 404). */
  noindex?: boolean;
  ogImage?: string;
}

const { title, description = site.intro, section, noindex = false, ogImage } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1') || '/';
const canonical = Astro.site ? new URL(current, Astro.site).href : undefined;
const robots = noindex || SHOW_DRAFTS ? 'noindex, nofollow' : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && !robots && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && Astro.site && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#F3F0E9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:inline>
      @view-transition { navigation: auto; }
      @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }
    </style>
    <script is:inline set:html={cutScript} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <header class="topbar">
      <a class="brand" href="/" aria-label={`${site.name} — home`}><span>Setayesh</span> <span>Ganji</span></a>
      <span class="topbar-role">{site.role}</span>
      <button class="menu-button" type="button" aria-haspopup="dialog" aria-controls="menu" aria-expanded="false" data-menu-open>
        Menu <span class="bars" aria-hidden="true"></span>
      </button>
    </header>

    <dialog class="menu" id="menu" aria-label="Menu">
      <div class="menu-head">
        <a class="brand" href="/"><span>Setayesh</span> <span>Ganji</span></a>
        <button class="menu-close" type="button" data-menu-close>
          Close
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 2l12 12M14 2L2 14" /></svg>
        </button>
      </div>
      <div class="menu-body">
        <Nav current={current} section={section} id="menu-nav" />
        <p class="menu-foot">{site.role}<br />{site.location}</p>
      </div>
    </dialog>

    <div class="shell">
      <aside class="sidebar" aria-label="Site">
        <a class="brand" href="/" aria-current={current === '/' ? 'page' : undefined}><span>Setayesh</span> <span>Ganji</span></a>
        <p class="brand-role">{site.role}</p>
        <Nav current={current} section={section} id="side-nav" />
        <p class="sidebar-foot">{site.location}<br />{site.availability}</p>
      </aside>

      <main class="main stage" id="content" tabindex="-1">
        <slot />
        <Footer />
      </main>
    </div>

    <div class="cutline" aria-hidden="true">
      <span class="cutline-rule"></span>
      <svg class="cutline-scissors" viewBox="0 0 30 30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <circle cx="6.5" cy="9" r="3.6" />
        <circle cx="6.5" cy="21" r="3.6" />
        <path d="M9.6 10.8L27.5 18.2M9.6 19.2L27.5 11.8" />
        <circle cx="17.6" cy="15" r="0.9" fill="currentColor" stroke="none" />
      </svg>
    </div>

    {SHOW_DRAFTS && <p class="preview-flag" aria-hidden="true">Preview · drafts visible</p>}

    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
