---
import Media from './Media.astro';
import type { Project } from '../lib/content';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const d = project.data;
// Phones show only the project's name: the part of the title before its dash or colon.
const shortTitle = d.title.split(/\s+—\s+|:\s+/)[0];
---

<li class="pp">
  <a class="pp-link" href={`/projects/${project.id}`}>
    <div class="pp-media">
      <Media
        media={{ ...d.cover, aspect: '1/1', fit: 'cover' }}
        sizes="(min-width: 900px) 33vw, 50vw"
        eager={index < 3}
        showCaption={false}
        fallbackAspect="1/1"
        placeholderLabel="Cover to come"
        inLink
      />
    </div>
    <span class="pp-meta">
      <span class="pp-title pp-title--full">{d.title}</span>
      <span class="pp-title pp-title--short" aria-hidden="true">{shortTitle}</span>
    </span>
  </a>
</li>
