---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Placeholder from '../components/Placeholder.astro';
import { categories } from '../config/categories';
import { site } from '../config/site';
import { getProjectsIn, resolveImage } from '../lib/content';

const tiles = await Promise.all(
  categories.map(async (c, i) => {
    const projects = await getProjectsIn(c.slug);
    // Preview: the category's own preview image, else the first project cover that has a file.
    const preview = c.homePreview && resolveImage(c.homePreview.file)
      ? { file: c.homePreview.file, alt: c.homePreview.alt, position: c.homePreview.position }
      : projects.find((p) => resolveImage(p.data.cover.file))?.data.cover;
    return { c, i, count: projects.length, preview };
  }),
);

const tileSizes = [
  '(min-width: 1024px) 48vw, 100vw',
  '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
  '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
  '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
  '(min-width: 1024px) 48vw, (min-width: 640px) 50vw, 100vw',
];
---

<Base>
  <h1 class="visually-hidden">{site.name} — {site.role}</h1>
  <section class="home-intro" aria-label="Introduction">
    <p class="hero-statement">
      Visual and multimedia design across
      <a class="band--brand-identity" href="/work/brand-identity">identity</a>,
      <a class="band--graphic-illustration" href="/work/graphic-illustration">illustration</a>,
      <a class="band--digital-ui" href="/work/digital-ui">interfaces</a>,
      <a class="band--motion-film" href="/work/motion-film">motion, film</a>,
      <a class="band--interactive-3d" href="/work/interactive-3d">3D and 4D</a>.
    </p>
    <p class="home-status settle-late">
      <span><span class="status-dot" aria-hidden="true"></span>{site.availability}</span>
      <span>{site.location}</span>
    </p>
  </section>

  <section class="home-grid" aria-label="Discipline previews">
    {
      tiles.map(({ c, i, count, preview }) => (
        <a class={`tile tile--${i + 1} band--${c.slug}`} href={`/work/${c.slug}`}>
          <div class="tile-caption">
            <h2 class="tile-title">{c.title}</h2>
            <span class="tile-sub">
              <span>{count === 0 ? 'Coming soon' : `${count}\u00a0${count === 1 ? 'project' : 'projects'}`}</span>
              <span class="tile-cta" aria-hidden="true">View <span class="arrow">→</span></span>
            </span>
          </div>
          <div class="tile-media">
            {preview ? (
              <Media
                media={{ ...preview, aspect: c.homeAspect, fit: 'cover' }}
                sizes={tileSizes[i]}
                eager={i < 2}
                showCaption={false}
                inLink
              />
            ) : (
              <Placeholder label="Temporary visual" detail={c.title} aspect={c.homeAspect} />
            )}
          </div>
        </a>
      ))
    }
  </section>
</Base>
