---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/standard-italic.css';
import '@fontsource-variable/instrument-sans/standard.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Rail from '../components/Rail.astro';
import Scissors from '../components/Scissors.astro';
import { categories } from '../config/categories';
import { site } from '../config/site';
import { SHOW_DRAFTS } from '../lib/content';

interface Props {
  /** Page title; the site name is appended. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Discipline slug this page belongs to (highlights it in navigation). */
  section?: string;
  /** Mark as not indexable (drafts, 404). */
  noindex?: boolean;
  ogImage?: string;
}

const { title, description = site.intro, section, noindex = false, ogImage } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1') || '/';
const canonical = Astro.site ? new URL(current, Astro.site).href : undefined;
const robots = noindex || SHOW_DRAFTS ? 'noindex, nofollow' : undefined;

// Desktop layout. With a discipline open, its band takes the free width and the page sits inside it;
// the other bands stay as narrow strips. Otherwise the page sits to the right of five strips.
const openIndex = categories.findIndex((c) => c.slug === section);
const deckCols =
  openIndex < 0
    ? 'repeat(5, var(--band-w)) minmax(0, 1fr)'
    : [...categories.map((_, i) => (i === openIndex ? 'minmax(0, 1fr)' : 'var(--band-w)')), '0px'].join(' ');
const stageCol = openIndex < 0 ? 6 : openIndex + 1;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && !robots && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && Astro.site && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#F3F0E9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <header class="topbar">
      <a class="brand" href="/" aria-label={`${site.name} — home`}><span>Setayesh</span> <span>Ganji</span></a>
      <span class="topbar-role">{site.role}</span>
      <button class="menu-button" type="button" aria-haspopup="dialog" aria-controls="menu" aria-expanded="false" data-menu-open>
        Menu <span class="bars" aria-hidden="true"></span>
      </button>
    </header>

    <dialog class="menu" id="menu" aria-label="Menu">
      <div class="menu-head">
        <a class="brand" href="/"><span>Setayesh</span> <span>Ganji</span></a>
        <button class="menu-close" type="button" data-menu-close>
          Close
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 2l12 12M14 2L2 14" /></svg>
        </button>
      </div>
      <div class="menu-body">
        <Nav current={current} section={section} id="menu-nav" />
        <p class="menu-foot">{site.role}<br />{site.location}</p>
      </div>
    </dialog>

    <div class="deck" style={`--deck-cols: ${deckCols}; --stage-col: ${stageCol}`}>
      <Rail section={section} />

      <div class:list={['stage', section && `band--${section}`, section && 'is-open']}>
        {
          section ? (
            <a class="scissors" href="/" aria-label="Back to all disciplines">
              <Scissors />
            </a>
          ) : (
            <span class="scissors">
              <Scissors />
            </span>
          )
        }

        <header class="page-head">
          <a class="wordmark" href="/" aria-label={`${site.name}, home`}>{site.name}</a>
          <nav class="page-nav" aria-label="Pages">
            <a href="/essays" aria-current={current === '/essays' || current.startsWith('/essays/') ? 'page' : undefined}>Essays</a>
            <a href="/about" aria-current={current === '/about' ? 'page' : undefined}>About</a>
            <a href="/contact" aria-current={current === '/contact' ? 'page' : undefined}>Contact</a>
          </nav>
        </header>

        <main class="main" id="content" tabindex="-1">
          <slot />
          <Footer current={current} />
        </main>
      </div>
    </div>

    <dialog class="lightbox" id="lightbox" aria-label="Image viewer">
      <div class="lightbox-bar">
        <p class="lightbox-count" aria-live="polite"></p>
        <button class="lightbox-close" type="button" data-lightbox-close>Close <span aria-hidden="true">×</span></button>
      </div>
      <figure class="lightbox-figure">
        <img class="lightbox-img" alt="" />
        <figcaption class="lightbox-caption"></figcaption>
      </figure>
      <div class="lightbox-nav">
        <button class="lightbox-prev" type="button" data-lightbox-prev>
          <span aria-hidden="true">←</span> Previous<span class="visually-hidden"> image</span>
        </button>
        <button class="lightbox-next" type="button" data-lightbox-next>
          Next<span class="visually-hidden"> image</span> <span aria-hidden="true">→</span>
        </button>
      </div>
    </dialog>

    {SHOW_DRAFTS && <p class="preview-flag" aria-hidden="true">Preview · drafts visible</p>}

    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
