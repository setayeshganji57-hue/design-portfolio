---
/**
 * Renders a project's flexible content blocks. Each project combines only
 * the blocks it needs — no fixed case-study structure.
 */
import Media from './Media.astro';
import VideoEmbed from './VideoEmbed.astro';
import { paragraphs } from '../lib/logic';
import type { Project } from '../lib/content';

interface Props {
  blocks: Project['data']['blocks'];
}

const { blocks } = Astro.props;
// Images sit in small 4:3 tiles on a four-column gallery grid (two on phones);
// the viewer shows them large. A single image spans two columns.
const tileSizes = '(min-width: 900px) 15rem, 45vw';
const wideTileSizes = '(min-width: 900px) 30rem, 92vw';
const isPortrait = (aspect: string) => {
  const [w, h] = aspect.split('/').map(Number);
  return w < h;
};
---

{
  blocks.length > 0 && (
    <div class="blocks">
      {blocks.map((b) => {
        switch (b.type) {
          case 'text':
            return (
              <section class="b-text">
                {b.heading && <h2>{b.heading}</h2>}
                {paragraphs(b.body).map((p) => (
                  <p>{p}</p>
                ))}
              </section>
            );
          case 'image':
            return (
              <div class="b-gallery">
                <div class="gallery">
                  <div class="g-tile g-tile--wide">
                    <Media media={b.media} zoom tile sizes={wideTileSizes} small />
                  </div>
                </div>
              </div>
            );
          case 'pair':
          case 'grid':
            return (
              <div class="b-gallery">
                <div class="gallery">
                  {b.items.map((m) => (
                    <div class:list={['g-tile', b.tiles === 'wide' && 'g-tile--wide']}>
                      <Media media={m} zoom tile tileAspect={b.tiles === 'portrait' ? '3/5' : '4/3'} sizes={b.tiles === 'wide' ? wideTileSizes : tileSizes} small />
                    </div>
                  ))}
                </div>
                {b.caption && <p class="block-caption">{b.caption}</p>}
              </div>
            );
          case 'video':
            return (
              <div class:list={['b-video', isPortrait(b.video.aspect) && 'b-video--portrait']}>
                <VideoEmbed video={b.video} sizes={isPortrait(b.video.aspect) ? '18rem' : undefined} />
              </div>
            );
        }
      })}
    </div>
  )
}
