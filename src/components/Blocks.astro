---
/**
 * Renders a project's flexible content blocks. Each project combines only
 * the blocks it needs — no fixed case-study structure.
 */
import Media from './Media.astro';
import VideoEmbed from './VideoEmbed.astro';
import { paragraphs } from '../lib/logic';
import { tileRatio, type Project } from '../lib/content';

interface Props {
  blocks: Project['data']['blocks'];
}

const { blocks } = Astro.props;
// Images sit in small 4:3 tiles on a four-column gallery grid (two on phones);
// the viewer shows them large. A single image spans two columns.
const tileSizes = '(min-width: 900px) 15rem, 45vw';
const wideTileSizes = '(min-width: 900px) 30rem, 92vw';
const thirdTileSizes = '(min-width: 900px) 20rem, 45vw';
const isPortrait = (aspect: string) => {
  const [w, h] = aspect.split('/').map(Number);
  return w < h;
};
---

{
  blocks.length > 0 && (
    <div class="blocks">
      {blocks.map((b) => {
        switch (b.type) {
          case 'text':
            return (
              <section class="b-text">
                {b.heading && <h2>{b.heading}</h2>}
                {paragraphs(b.body).map((p) => (
                  <p>{p}</p>
                ))}
              </section>
            );
          case 'image': {
            // A single landscape image spans two columns; square and portrait ones stay one column wide.
            const shape = tileRatio([b.media.file]);
            return (
              <div class="b-gallery">
                <div class="gallery">
                  <div class:list={['g-tile', b.size === 'large' ? 'g-tile--full' : shape.wide && 'g-tile--wide']}>
                    <Media media={b.media} zoom tile tileAspect={shape.aspect} sizes={b.size === 'large' ? '(min-width: 900px) 58rem, 92vw' : shape.wide ? wideTileSizes : tileSizes} small />
                  </div>
                </div>
              </div>
            );
          }
          case 'pair':
          case 'grid': {
            const shape = tileRatio(b.items.map((m) => m.file));
            // A grid that asks for three columns gets them; everything else uses the four-column gallery.
            const threeUp = b.type === 'grid' && b.columns === 3;
            return (
              <div class="b-gallery">
                <div class:list={['gallery', threeUp && 'gallery--3']}>
                  {b.items.map((m) => (
                    <div class:list={['g-tile', b.tiles === 'wide' && 'g-tile--wide']}>
                      <Media media={m} zoom tile tileAspect={shape.aspect} sizes={b.tiles === 'wide' ? wideTileSizes : threeUp ? thirdTileSizes : tileSizes} small />
                    </div>
                  ))}
                </div>
                {b.caption && <p class="block-caption">{b.caption}</p>}
              </div>
            );
          }
          case 'videos':
            // Two or three films get a three-column row so each plays larger.
            return (
              <div class="b-gallery">
                <div class:list={['gallery', b.items.length <= 3 && 'gallery--3']}>
                  {b.items.map((v) => (
                    <div class="g-tile">
                      <VideoEmbed video={v} sizes={b.items.length <= 3 ? thirdTileSizes : '(min-width: 900px) 15rem, 45vw'} />
                    </div>
                  ))}
                </div>
                {b.caption && <p class="block-caption">{b.caption}</p>}
              </div>
            );
          case 'video':
            return (
              <div class:list={['b-video', isPortrait(b.video.aspect) && 'b-video--portrait']}>
                <VideoEmbed video={b.video} sizes={isPortrait(b.video.aspect) ? '18rem' : undefined} />
              </div>
            );
        }
      })}
    </div>
  )
}
