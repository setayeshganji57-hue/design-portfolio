---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import Media from '../components/Media.astro';
import { site } from '../config/site';
import { resolveImage } from '../lib/content';

const portrait = site.portrait && resolveImage(site.portrait.file) ? site.portrait : null;
---

<Base title="About me" description={site.about[0]}>
  <div class="about">
    <h1 class="split-title">About me</h1>
    <!-- Portrait and text share one top line: the photo's frame and the first line of text start together. -->
    <div class="about-row">
      <div class="about-portrait">
        {
          portrait ? (
            <Media media={{ file: portrait.file, alt: portrait.alt, aspect: '3/4', fit: 'cover' }} sizes="(min-width: 900px) 24rem, 100vw" eager />
          ) : (
            <Placeholder label="Portrait to come" aspect="3/4" glyph="SG" />
          )
        }
      </div>
      <div class="about-intro">
        {site.about.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</Base>
