---
import { categories } from '../config/categories';
import { getProjectsIn } from '../lib/content';

interface Props {
  /** Discipline the current page belongs to; that band opens instead of linking. */
  section?: string;
}

const { section } = Astro.props;

// Counts respect draft filtering. They are for screen readers only; nothing is printed on the bands.
const counts = Object.fromEntries(
  await Promise.all(categories.map(async (c) => [c.slug, (await getProjectsIn(c.slug)).length] as const)),
);
---

{
  categories.map((c, i) => {
    // Each band is named in the page transition, so it slides into its new place when the discipline opens.
    const style = `--i: ${i + 1}; view-transition-name: band-${c.slug}`;
    return section === c.slug ? (
      <span class={`band band--${c.slug}`} aria-current="true" style={style} aria-hidden="true">
        <span class="band-label">{c.title}</span>
      </span>
    ) : (
      <a class={`band band--${c.slug}`} href={`/work/${c.slug}`} style={style}>
        <span class="band-label">{c.title}</span>
        <span class="visually-hidden">, {counts[c.slug]} {counts[c.slug] === 1 ? 'project' : 'projects'}</span>
      </a>
    );
  })
}
